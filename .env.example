# AccessBelt Analytics — environment configuration
#
# Copy to `.env.local` and fill in from the Firebase console
# (Project settings -> General -> Your apps -> SDK setup and configuration).
#
# Leave VITE_USE_FIREBASE unset or "false" to run entirely on demonstration
# data. The dashboard is fully functional in that mode.
#
# None of these values is a secret. Firebase web API keys are public
# identifiers that ship inside every client bundle by design. Access control
# comes from Firestore security rules and App Check — not from hiding this key.

VITE_USE_FIREBASE=false

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
